    },
    {
      "name": "campaigns",
      "enabled": true,
      "spec_path": "campaigns.yaml",
      "bundled_path": ".bundled/campaigns.json"
    },
    {
      "name": "inventory",
      "enabled": true,
      "spec_path": "inventory.yaml",
      "bundled_path": ".bundled/inventory.json"
    },
    {
      "name": "bidding",
      "enabled": true,

          "handlers": "@clearbid/core",
          "schemas": "@clearbid/core",
          "validators": "@clearbid/core",
          "converters": "@clearbid/core",
          "shared_helpers": "@clearbid/core/_shared/helpers",
          "shared_repositories": "@clearbid/core/_shared/repositories",
          "shared_types": "@clearbid/core/_shared/types"
        }
      },
      "services": {
        "base": "platform/services/src",
        "imports": {
          "types": "@clearbid/core",
          "repositories": "@clearbid/core",
          "handlers": "@clearbid/core",
          "schemas": "@clearbid/core",
          "validators": "@clearbid/core",
          "converters": "@clearbid/core",
          "shared_helpers": "@clearbid/core/_shared/helpers",
          "shared_repositories": "@clearbid/core/_shared/repositories",
          "shared_types": "@clearbid/core/_shared/types"
        }
      },
      "adapters": {
        "base": "platform/adapters/src",
        "imports": {
          "types": "@clearbid/core",
          "repositories": "@clearbid/core",
          "handlers": "@clearbid/core",
          "schemas": "@clearbid/core",
          "validators": "@clearbid/core",
          "converters": "@clearbid/core",
          "shared_helpers": "@clearbid/core/_shared/helpers",
          "shared_repositories": "@clearbid/core/_shared/repositories",
          "shared_types": "@clearbid/core/_shared/types"
        }

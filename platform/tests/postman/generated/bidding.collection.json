{
  "info": {
    "name": "Bidding API",
    "description": "Real-time bid requests (~100\u2013200ms) and pre-commit action forecasts.\nAuction prices on P(action) \u00d7 economic value, not CTR.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.clearbid.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "campaignId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Bidding",
      "item": [
        {
          "name": "submitBidRequest",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/bid-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "bid-requests"
              ],
              "query": []
            },
            "description": "Submit a bid request and receive clearing price + attribution token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"newman_requestId\",\n  \"slotId\": \"newman_slotId\",\n  \"consentRecordId\": \"newman_consentRecordId\",\n  \"consentPurpose\": \"\",\n  \"audienceSignals\": null,\n  \"deviceType\": \"\",\n  \"geo\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('submitBidRequest status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getActionForecast",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/campaigns/{{campaignId}}/action-forecast",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "campaigns",
                "{{campaignId}}",
                "action-forecast"
              ],
              "query": []
            },
            "description": "Forecast achievable actions and CPA before budget commit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getActionForecast status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.actionForecastId || j.data.id; if (id) { pm.collectionVariables.set('actionForecastId', id); pm.environment.set('actionForecastId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
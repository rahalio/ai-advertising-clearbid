{
  "info": {
    "name": "Conversions API",
    "description": "Attribution-token redemption and append-only conversion ledger.\nBoth counterparties can verify proofs; neither can unilaterally rewrite settled records (BR-1, BR-12).\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.clearbid.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "conversionId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Conversions",
      "item": [
        {
          "name": "listConversions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/conversions?cursor={{cursor}}&limit={{limit}}&status={{status}}&campaignId={{campaignId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "conversions"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "status",
                  "value": "{{status}}"
                },
                {
                  "key": "campaignId",
                  "value": "{{campaignId}}"
                }
              ]
            },
            "description": "List conversion records"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listConversions status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.conversionId || it.id; if (id) { pm.collectionVariables.set('conversionId', id); pm.environment.set('conversionId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "attestConversion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/conversions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "conversions"
              ],
              "query": []
            },
            "description": "Attest a conversion against a signed attribution token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attributionToken\": \"newman_attributionToken\",\n  \"actionType\": \"registration\",\n  \"occurredAt\": \"\",\n  \"externalReference\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('attestConversion status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getConversionVerification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/conversions/{{conversionId}}/verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "conversions",
                "{{conversionId}}",
                "verification"
              ],
              "query": []
            },
            "description": "Get hash-chained ledger proof for a conversion"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getConversionVerification status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.conversionVerificationId || j.data.id; if (id) { pm.collectionVariables.set('conversionVerificationId', id); pm.environment.set('conversionVerificationId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
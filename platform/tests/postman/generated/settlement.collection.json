{
  "info": {
    "name": "Settlement API",
    "description": "Settlement statements and publisher payouts against the conversion ledger.\nSpend clears only against mutually verified, non-excluded records (BR-1, BR-10).\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.clearbid.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "statementId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Settlement",
      "item": [
        {
          "name": "listSettlementStatements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/settlement/statements?cursor={{cursor}}&limit={{limit}}&counterpartyType={{counterpartyType}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "settlement",
                "statements"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "counterpartyType",
                  "value": "{{counterpartyType}}"
                }
              ]
            },
            "description": "List settlement statements"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listSettlementStatements status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.settlementStatementId || it.id; if (id) { pm.collectionVariables.set('settlementStatementId', id); pm.environment.set('settlementStatementId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "getSettlementStatement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/settlement/statements/{{statementId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "settlement",
                "statements",
                "{{statementId}}"
              ],
              "query": []
            },
            "description": "Get a settlement statement"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getSettlementStatement status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.settlementStatementId || j.data.id; if (id) { pm.collectionVariables.set('settlementStatementId', id); pm.environment.set('settlementStatementId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "executePublisherPayout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/settlement/payouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "settlement",
                "payouts"
              ],
              "query": []
            },
            "description": "Execute publisher payout against a statement",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statementId\": \"newman_statementId\",\n  \"paymentReference\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('executePublisherPayout status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
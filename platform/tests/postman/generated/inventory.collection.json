{
  "info": {
    "name": "Inventory API",
    "description": "Publisher properties, slots, category blocks, and IVT quarantine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.clearbid.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "slotId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Inventory",
      "item": [
        {
          "name": "listInventorySlots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/inventory/slots?cursor={{cursor}}&limit={{limit}}&status={{status}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "inventory",
                "slots"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "status",
                  "value": "{{status}}"
                }
              ]
            },
            "description": "List inventory slots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listInventorySlots status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.inventorySlotId || it.id; if (id) { pm.collectionVariables.set('inventorySlotId', id); pm.environment.set('inventorySlotId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "registerInventorySlot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/inventory/slots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "inventory",
                "slots"
              ],
              "query": []
            },
            "description": "Register an inventory slot",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property\": \"\",\n  \"format\": \"display\",\n  \"blockedAdvertiserCategories\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('registerInventorySlot status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "quarantineInventorySlot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/inventory/slots/{{slotId}}/quarantine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "inventory",
                "slots",
                "{{slotId}}",
                "quarantine"
              ],
              "query": []
            },
            "description": "Quarantine a slot after IVT threshold breach",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"\",\n  \"invalidTrafficRate\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('quarantineInventorySlot status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
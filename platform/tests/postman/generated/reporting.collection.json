{
  "info": {
    "name": "Reporting API",
    "description": "Performance and audit exports. Verified CPA is reported against the\nadvertiser's incumbent channel on the same conversion definition (BR-3).\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.clearbid.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Reporting",
      "item": [
        {
          "name": "getCostPerActionReport",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reports/cost-per-action?campaignId={{campaignId}}&period={{period}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "reports",
                "cost-per-action"
              ],
              "query": [
                {
                  "key": "campaignId",
                  "value": "{{campaignId}}"
                },
                {
                  "key": "period",
                  "value": "{{period}}"
                }
              ]
            },
            "description": "Verified CPA versus incumbent benchmark"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('getCostPerActionReport status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); if (j.data) { var id = j.data.costPerActionReportId || j.data.id; if (id) { pm.collectionVariables.set('costPerActionReportId', id); pm.environment.set('costPerActionReportId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
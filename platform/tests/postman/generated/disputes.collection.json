{
  "info": {
    "name": "Disputes API",
    "description": "Time-boxed dispute adjudication. Unresolved disputes default to recorded\nledger evidence in favour of the conversion record (BR-4).\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.clearbid.local"
    },
    {
      "key": "orgId",
      "value": "test-org"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "disputeId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Disputes",
      "item": [
        {
          "name": "listDisputes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/disputes?cursor={{cursor}}&limit={{limit}}&status={{status}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "disputes"
              ],
              "query": [
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                },
                {
                  "key": "status",
                  "value": "{{status}}"
                }
              ]
            },
            "description": "List disputes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('listDisputes status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });",
                  "var j = pm.response.json(); var items = (j.data && j.data.items) || []; if (items.length) { var it = items[0]; var id = it.disputeId || it.id; if (id) { pm.collectionVariables.set('disputeId', id); pm.environment.set('disputeId', id); pm.collectionVariables.set('id', id); pm.environment.set('id', id); } }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "openDispute",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/disputes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "disputes"
              ],
              "query": []
            },
            "description": "Open a dispute against a conversion record",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversionId\": \"newman_conversionId\",\n  \"claim\": \"shaving\",\n  \"evidence\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('openDispute status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "resolveDispute",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/disputes/{{disputeId}}/resolution",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "disputes",
                "{{disputeId}}",
                "resolution"
              ],
              "query": []
            },
            "description": "Resolve a dispute within the time-box",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"upheld\",\n  \"rationale\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('resolveDispute status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has envelope', function () { var j = pm.response.json(); pm.expect(j).to.have.property('data'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}